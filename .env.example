
# ВАЖНО для деплоя (Amvera / любой сервер):
#   * SECRET_KEY — обязательно замените на 32+ случайных байт.
#     Можно сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
#   * TEACHER_PASSWORD — смените с admin123 на что-то сложное.
#   * DB_URL — на Amvera укажите sqlite:////data/db.sqlite3 (4 слэша!)
#     и DATA_DIR=/data, чтобы БД и файлы переживали редеплой.
#   * При первом деплое миграции делать не нужно: main.py сам создаст
#     таблицы и учителя из env, если их нет.

# Скопируйте в .env и при необходимости измените
SECRET_KEY=change-me-please-to-random-32-bytes
TEACHER_USERNAME=admin
TEACHER_PASSWORD=admin123

# Путь к БД и данным (на Amvera — /data)
DB_URL=sqlite:///./data/db.sqlite3
DATA_DIR=./data

# Лимиты запуска кода ученика
RUN_TIMEOUT_SEC=5
RUN_MEMORY_MB=128
RUN_MAX_CONCURRENT=4
